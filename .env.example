# Ollama Configuration
# --------------------
# Base URL for the Ollama API server
export OLLAMA_BASE_URL=http://localhost:11434

# Default LLM model to use when starting the chat
# Make sure this model is installed (ollama pull <model-name>)
export OLLAMA_DEFAULT_MODEL=qwen3.5:9b

# Command to start Ollama server if it's not already running
# Uncomment and set this to enable automatic Ollama startup
# Examples:
#   - Direct: OLLAMA_START_COMMAND="ollama serve"
#   - macOS Homebrew: OLLAMA_START_COMMAND="brew services start ollama"
#   - Linux systemd: OLLAMA_START_COMMAND="systemctl start ollama"
export OLLAMA_START_COMMAND="ollama serve"

# Command to kill Ollama server if it's running
# Examples:
#   - macOS/Linux: pkill -9 ollama  OR  killall ollama
#   - Windows PowerShell: Stop-Process -Name ollama -Force
#   - Windows CMD: taskkill /F /IM ollama.exe
#   - Docker: docker stop ollama && docker rm ollama
export OLLAMA_KILL_COMMAND="pkill -9 ollama"

# Timeout (in milliseconds) for a streaming response before giving up
# Default: 30000 (30 seconds)
# export OLLAMA_STREAM_TIMEOUT_MS=30000

# Health check: whether to periodically poll Ollama to confirm it is healthy
# Default: true
# export OLLAMA_HEALTH_CHECK_ENABLED=true

# How often (in milliseconds) to run the health check poll
# Default: 30000 (30 seconds)
# export OLLAMA_HEALTH_CHECK_INTERVAL_MS=30000

# Memory system: set to false to disable the database-backed memory system
# When disabled, the app works normally but without persistent memory
# Default: true
# export OLLAMA_MEMORY_ENABLED=true

# Embedding model for semantic memory search
# Must be pulled in Ollama first: ollama pull nomic-embed-text
# Default: nomic-embed-text (768 dimensions)
# export OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# MCP (Model Context Protocol) Configuration
# -------------------------------------------
# Path to the MCP servers JSON config file
# Defaults to ~/.config/ollama-chat/mcp_servers.json when unset
# export MCP_CONFIG_PATH=/path/to/mcp_servers.json

# PostgreSQL Database Configuration
# ---------------------------------
# Required for the memory system. Start the container with:
#   ./scripts/postgres-docker.sh start
export OLLAMA_CHAT_DB_USERNAME=ollama_chat
export OLLAMA_CHAT_DB_PASSWORD=ollama_chat
export OLLAMA_CHAT_DB_NAME=ollama_chat_dev
export OLLAMA_CHAT_DB_HOSTNAME=localhost
export OLLAMA_CHAT_DB_PORT=5432

# Directory for persistent PostgreSQL data (container volume)
# export OLLAMA_CHAT_POSTGRES_DATA_DIR=./priv/postgres_data

# Production-only: full database URL (overrides individual settings above)
# export OLLAMA_CHAT_DB_URL=ecto://user:pass@host/database
# export OLLAMA_CHAT_DB_POOL_SIZE=10

# Phoenix Server Configuration
# -----------------------------
# Port to run the Phoenix web server on
export OLLAMA_CHAT_PORT=4000

# Production Configuration (optional)
# ------------------------------------
# Only needed when running in production mode

# Generate a secret key with: mix phx.gen.secret
# export SECRET_KEY_BASE=your_secret_key_here

# Your domain name (for production deployments)
# export PHX_HOST=example.com

# Enable the Phoenix server (for releases)
# export PHX_SERVER=true

# DNS cluster query for distributed deployments
# export DNS_CLUSTER_QUERY=your_dns_query_here
