# PostgreSQL 16 with pgvector extension for ollama_chat
# Builds pgvector v0.7.4 from source on Alpine
FROM docker.io/library/postgres:16-alpine

# Disable JIT to avoid LLVM dependencies
ENV PGSQL_JIT=off

# Install postgresql-contrib and build dependencies, compile pgvector
RUN apk add --no-cache postgresql-contrib && \
    apk add --no-cache --virtual .build-deps \
        git \
        build-base \
        postgresql-dev && \
    cd /tmp && \
    git clone --branch v0.7.4 https://github.com/pgvector/pgvector.git && \
    cd pgvector && \
    make vector.so || true && \
    make sql/vector--0.7.4.sql && \
    cp vector.so /usr/local/lib/postgresql/ && \
    cp sql/vector--0.7.4.sql /usr/local/share/postgresql/extension/ && \
    cp vector.control /usr/local/share/postgresql/extension/ && \
    cd / && \
    rm -rf /tmp/pgvector && \
    apk del .build-deps

# Default environment variables
ENV POSTGRES_USER=ollama_chat
ENV POSTGRES_PASSWORD=ollama_chat
ENV POSTGRES_DB=ollama_chat_dev

# Init script to enable extensions on database creation
RUN mkdir -p /docker-entrypoint-initdb.d && \
    cat > /docker-entrypoint-initdb.d/01-enable-extensions.sh <<'EOF'
#!/bin/bash
set -e

echo "Enabling extensions on template1..."
psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname template1 <<-EOSQL
    CREATE EXTENSION IF NOT EXISTS citext;
    CREATE EXTENSION IF NOT EXISTS vector;
EOSQL

echo "Enabling extensions on $POSTGRES_DB..."
psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" <<-EOSQL
    CREATE EXTENSION IF NOT EXISTS citext;
    CREATE EXTENSION IF NOT EXISTS vector;
EOSQL

echo "Extensions enabled successfully."
EOF

RUN chmod +x /docker-entrypoint-initdb.d/01-enable-extensions.sh

VOLUME ["/var/lib/postgresql/data"]

HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=30s \
    CMD pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB" || exit 1

CMD ["postgres"]
